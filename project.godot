[layer_names]

2d_physics/layer_1="stone"
2d_physics/layer_2="world_a"
2d_physics/layer_3="world_b"
2d_physics/layer_4="bars"
2d_physics/layer_5="walls"
2d_physics/layer_6="bridge"
2d_physics/layer_7="door"
2d_physics/layer_8="timed_a"
2d_physics/layer_9="timed_b"
2d_physics/layer_10="spikes"
2d_physics/layer_11="player"
2d_physics/layer_12="interact"
2d_physics/layer_13="zone"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.012, 0.012, 0.024, 1)
